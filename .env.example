# Local-only values. Generate a unique password; never use production credentials.
# DATABASE_URL — runtime (src/lib/prisma.ts, pooler do Neon)
# DIRECT_URL   — `npx prisma db push` / migrations (conexão direta)
DATABASE_URL=
DIRECT_URL=
POSTGRES_PASSWORD=
# Build-time public values. Leave empty until the API and Turnstile are deployed.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# SMTP — envio do Diagnóstico Gratuito (nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Destinatário dos diagnósticos (padrão: contato@sinaptech.com.br)
DIAGNOSTIC_TO_EMAIL=
